# Copy this file to .env and fill in real values before running:
#   docker compose up --build
#
# Every one of these already has a dev-safe default baked into
# docker-compose.yml (via ${VAR:-default}), so the stack also boots with NO
# .env file at all for a quick smoke test. Don't reuse those defaults
# anywhere real.

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=marketplace_db
# Used by `npm run dev` and Prisma CLI on your machine. 55432 is the host port
# docker-compose publishes Postgres on. Keep user/password/db in sync with the
# three values above. (docker-compose builds its own in-network URL.)
DATABASE_URL=postgresql://marketplace:postgrespassword@localhost:55432/marketplace_db?schema=public

# ── Backend / API ─────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_REFRESH_SECRET=thisisaverylonghashedpasscodetounlockjwt000444555555322342234243234234
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://10.0.10.145:3000
API_BASE_URL=http://localhost:5000
# Browser-facing URL of the web app (links in verification / reset emails).
FRONTEND_URL=http://localhost:3000
# Run prisma migrations when the API container starts ("false" to skip).
AUTO_MIGRATE_ON_START=true
ADMIN_PASSWORD=adminpassword
ADMIN_SECRET=adminsecret
# POST /api/auth/admin-register is DISABLED in production unless this is "true".
# Enable it only long enough to create the first admin, then remove it.
# ENABLE_ADMIN_REGISTER=true
# ONLY for a throwaway local smoke test of the production containers; never real deployments.
# ALLOW_INSECURE_DEFAULTS=true
# Shared secret a payment gateway must send (header x-webhook-secret) to /api/cv-payment/confirm.
# CV_PAYMENT_WEBHOOK_SECRET=
# --- MTN Mobile Money (MoMo) — collection only ---------------------------------------------
# OFF by default. While MTN_ENABLED is not "true" nothing changes: payments are confirmed by an
# admin from the payment reference, exactly as before. The platform is the only beneficiary of
# every payment (subscriptions, store rentals, listing tiers, CV downloads): no escrow/splits/payouts.
# SANDBOX: create the API user + key once with `npm run momo:sandbox:provision` (needs only the
#   subscription key). PRODUCTION: MTN issues the API user/key — never reuse sandbox values.
# MTN_ENABLED=false
# MTN_ENVIRONMENT=sandbox                   # sandbox | production
# MTN_TARGET_ENVIRONMENT=sandbox            # sandbox | MTN's country value in production (e.g. mtnuganda)
# MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com   # production: the URL from your MTN onboarding pack
# MTN_SUBSCRIPTION_KEY=                     # primary key of the *Collections* product
# MTN_API_USER=                             # UUID v4 registered with MTN
# MTN_API_KEY=                              # secret — never commit or log
# MTN_CURRENCY=EUR                          # the sandbox only accepts EUR; production must be UGX (the default)
# Where MTN calls back: this BACKEND's public https origin (NOT the frontend's). A bare origin is enough —
# /api/payments/momo/callback is appended. Defaults to API_BASE_URL. Leave both unset for polling-only.
# In the sandbox the host must match the providerCallbackHost registered for the API user.
# MTN_CALLBACK_URL=https://api.example.com
# Signs each payment's callback URL (>= 32 chars). Required when callbacks are on: openssl rand -hex 32
# MTN_CALLBACK_SECRET=
# With MTN_ENABLED=true, /api/cv-payment/confirm no longer lets a browser mark a download as paid.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Optional: S3-compatible object storage. Leave blank to fall back to local
# disk uploads (persisted in the `lapit_uploads` Docker volume).
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
BUCKET=
ENDPOINT=

# Optional: transactional email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=user
SMTP_PASS=
SMTP_FROM=

# ── Frontend ───────────────────────────────────────────────────────────────
# Must be reachable from your BROWSER (this is baked into the client bundle
# at build time) — keep this as the host-published backend port, not the
# internal Docker service name. See the note at the top of docker-compose.yml.
NEXT_PUBLIC_API_URL=http://localhost:5000
