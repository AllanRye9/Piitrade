# Copy this file to .env and fill in real values before running:
#   docker compose up --build
#
# Every one of these already has a dev-safe default baked into
# docker-compose.yml (via ${VAR:-default}), so the stack also boots with NO
# .env file at all for a quick smoke test. Don't reuse those defaults
# anywhere real.

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=marketplace_db
DATABASE_URL=postgresql://marketplace:change-this-strong-password@localhost:55432/marketplace_db?schema=public

# ── Backend / API ─────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:5000
ADMIN_PASSWORD=change-this-strong-admin-password
ADMIN_SECRET=change-this-strong-admin-registration-secret
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Optional: S3-compatible object storage. Leave blank to fall back to local
# disk uploads (persisted in the `lapit_uploads` Docker volume).
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
BUCKET=
ENDPOINT=

# Optional: transactional email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=user
SMTP_PASS=
SMTP_FROM=

# ── Frontend ───────────────────────────────────────────────────────────────
# Must be reachable from your BROWSER (this is baked into the client bundle
# at build time) — keep this as the host-published backend port, not the
# internal Docker service name. See the note at the top of docker-compose.yml.
NEXT_PUBLIC_API_URL=https://<your-backend-service>.up.railway.app
