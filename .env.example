# ─────────────────────────────────────────────────────────────────────────────
# Single environment file for the whole application.
#
#   cp .env.example .env     # then fill in real values
#
# Used by:
#   • `npm run dev`          scripts/dev.mjs loads this file and passes it to
#                            BOTH the API (backend/) and the web app (frontend/)
#   • `docker compose up`    docker-compose.yml reads it for ${VAR} substitution
#   • backend Prisma CLI     backend/prisma.config.ts also looks at ../.env
#
# docker-compose.yml runs the backend with NODE_ENV=production, and the backend
# REFUSES TO START in production when JWT_SECRET / JWT_REFRESH_SECRET are missing,
# shorter than 32 characters, identical, or still contain placeholder text
# (change-this…, your-…, example…). So the placeholder values below must be
# replaced before `docker compose up`. Generate strong ones with:
#     openssl rand -hex 48
# `.env` is git-ignored. Details: SECURITY_AUDIT.md.
# Per-package examples (backend/.env.example, frontend/.env.example) remain for
# deployments that configure each service separately (e.g. Railway).
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=marketplace_db
# Used by `npm run dev` and Prisma CLI on your machine. 55432 is the host port
# docker-compose publishes Postgres on. Keep user/password/db in sync with the
# three values above. (docker-compose builds its own in-network URL.)
DATABASE_URL=postgresql://marketplace:change-this-strong-password@localhost:55432/marketplace_db?schema=public

# ── Backend / API ────────────────────────────────────────────────────────────
# >= 32 chars each, different from each other, no placeholder text (openssl rand -hex 48)
JWT_SECRET=change-this-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
# Browser-facing origin(s) of the web app; comma-separated for several.
CORS_ORIGIN=http://localhost:3000
# Public base URL of the API (used to build image URLs).
API_BASE_URL=http://localhost:5000
# Browser-facing URL of the web app (links in verification / reset emails).
FRONTEND_URL=http://localhost:3000
# Run prisma migrations when the API container starts ("false" to skip).
AUTO_MIGRATE_ON_START=true
ADMIN_PASSWORD=change-this-strong-admin-password
ADMIN_SECRET=change-this-strong-admin-registration-secret
# POST /api/auth/admin-register is DISABLED in production unless this is "true".
# Enable it only long enough to create the first admin, then remove it.
# ENABLE_ADMIN_REGISTER=true
# ONLY for a throwaway local smoke test of the production containers; never real deployments.
# ALLOW_INSECURE_DEFAULTS=true
# Shared secret a payment gateway must send (header x-webhook-secret) to /api/cv-payment/confirm.
# CV_PAYMENT_WEBHOOK_SECRET=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600

# Optional: S3-compatible object storage. Leave blank to fall back to local
# disk uploads (persisted in the `lapit_uploads` Docker volume).
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
BUCKET=
ENDPOINT=

# Optional: transactional email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional AI features (ad moderation, tag suggestions, support chat) are
# configured through backend/.env.example (HF_API_TOKEN / OPENAI_API_KEY /
# LLM_*). They are harmless no-ops when unset. Add them here (uncommented) to
# have `npm run dev` pass them through; docker-compose.yml does not forward them.

# ── Frontend ─────────────────────────────────────────────────────────────────
# MUST be a real URL reachable from your BROWSER — it is baked into the client
# bundle at build time. next.config.mjs aborts the build if it still contains
# a "<placeholder>". Local: the host-published API port. Production: the
# deployed API's https URL.
NEXT_PUBLIC_API_URL=http://localhost:5000
# Public URL of the web app itself (metadata, sitemap, robots, OG tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional. Image-AI worker used by "Auto-fill from photo" / photo search.
# Falls back to the shared deployed worker when unset.
# NEXT_PUBLIC_IMAGE_AI_URL=
# Optional. Where the Next.js server proxies same-origin /api/* and /uploads/*
# requests when NEXT_PUBLIC_API_URL is not set at build time (build-time value).
# Defaults to NEXT_PUBLIC_API_URL, then http://backend:5000.
# BACKEND_INTERNAL_URL=
# Optional. Comma-separated hosts the Next image optimizer may fetch from
# (e.g. api.example.com,cdn.example.com). Unset = any https host (legacy behaviour).
# NEXT_IMAGE_HOSTS=

# ── Local dev ports (`npm run dev` only) ─────────────────────────────────────
# BACKEND_PORT=5000
# FRONTEND_PORT=3000
