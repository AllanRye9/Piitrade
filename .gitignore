# Dependencies
node_modules/

# Build output (the old root-anchored "/dist" rule never matched backend/dist)
.next/
out/
build/
dist/
*.tsbuildinfo

# Generated by Intlayer at dev/build time — recreated automatically
frontend/.intlayer/

# Secrets and local env. Only the *.example files are tracked.
.env
.env.*
!.env.example

# Local uploads (backend falls back to disk when no S3 bucket is configured)
backend/uploads/

# Logs / tooling / OS
*.log
.npm/
.DS_Store
.vscode/
.idea/
coverage/

# Runtime data written by the backend (e.g. the farmer-marketplace JSON store)
backend/data/
backend/logs/
