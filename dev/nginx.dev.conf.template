# Generated into dev/.run/nginx.conf by dev.sh (placeholders are filled in). LOCAL DEVELOPMENT ONLY.
#
#   browser ──► nginx :@PORT@ ─┬─ /api/, /uploads/, /health ─► backend  127.0.0.1:@BACKEND_PORT@
#                              └─ everything else (+ HMR websocket) ─► Next dev 127.0.0.1:@FRONTEND_PORT@
#
# One origin for the whole app means the browser makes no cross-origin calls, so no CORS preflights and
# first-party cookies. (The backend is *also* given a CORS allow-list by dev.sh for anyone who opens the
# Next dev server directly on :@FRONTEND_PORT@ or from a phone on the LAN.)
daemon off;
worker_processes 1;                      # one worker is plenty for dev and keeps memory minimal
pid          @RUN@/nginx.pid;
error_log    @RUN@/logs/nginx.log warn;

events { worker_connections 512; }

http {
  access_log off;                        # less I/O; errors still go to the log above
  sendfile on;
  keepalive_timeout 65;
  server_tokens off;
  client_max_body_size 30m;              # image uploads
  proxy_buffer_size 16k;                 # Next dev sends large headers/cookies
  proxy_buffers 4 16k;
  proxy_busy_buffers_size 32k;

  # Writable temp dirs so nginx runs as your normal user (no root, no /var/lib).
  client_body_temp_path @RUN@/tmp/body;
  proxy_temp_path       @RUN@/tmp/proxy;
  fastcgi_temp_path     @RUN@/tmp/fastcgi;
  uwsgi_temp_path       @RUN@/tmp/uwsgi;
  scgi_temp_path        @RUN@/tmp/scgi;

  # "upgrade" only when the client asked for it (HMR websocket); otherwise empty so upstream keep-alive works.
  map $http_upgrade $connection_upgrade { default upgrade; '' ''; }

  upstream dev_backend  { server 127.0.0.1:@BACKEND_PORT@;  keepalive 8; }
  upstream dev_frontend { server 127.0.0.1:@FRONTEND_PORT@; keepalive 8; }

  server {
    listen @BIND@:@PORT@;
    server_name _;

    proxy_http_version 1.1;
    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;

    # API + uploaded files + health: straight to the backend. No buffering so server-sent events
    # (live alerts / notifications) arrive immediately. CORS headers come from the backend itself
    # (CORS_ORIGIN, set by dev.sh); nginx passes Origin through untouched and adds nothing, so
    # headers are never duplicated.
    location /api/     { proxy_pass http://dev_backend; proxy_buffering off; proxy_read_timeout 300s; }
    location /uploads/ { proxy_pass http://dev_backend; }
    location = /health { proxy_pass http://dev_backend; }

    # The Next dev server (pages, assets, HMR websocket). With a low memory cap Next restarts itself now and
    # then (it says "approaching the used memory threshold"); during those ~2 seconds show a self-refreshing
    # page instead of a bare 502.
    location / {
      proxy_pass http://dev_frontend;
      proxy_read_timeout 3600s;
      error_page 502 503 504 = @dev_restarting;
    }
    location @dev_restarting {
      default_type text/html;
      add_header Cache-Control "no-store" always;
      return 503 '<!doctype html><meta charset="utf-8"><meta http-equiv="refresh" content="2"><title>Restarting…</title><body style="font:16px system-ui;display:grid;place-items:center;height:100vh;margin:0;color:#444"><div style="text-align:center"><div style="font-size:34px">&#9203;</div>The dev server is restarting (memory cap) &mdash; this page refreshes by itself.</div>';
    }
  }
}
