# URL of the deployed backend API.
# Local development: http://localhost:5000
# Render:           https://<your-backend-service>.onrender.com
# Railway:          https://<your-backend-service>.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public URL of this frontend itself. Used server-side (metadata, sitemap.ts,
# robots.ts, canonical/OG URLs) where there's no browser window.location to
# fall back on. Falls back to https://piitrade.com if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL of the deployed image-AI Cloudflare Worker (classify/identify/describe),
# used by the "Auto-fill from photo" feature on /listings/create. Called
# directly from the browser (the worker allows CORS from any origin).
# Falls back to the shared deployed worker if unset.
NEXT_PUBLIC_IMAGE_AI_URL=https://apkit.allan-rye-999.workers.dev

# Google Search Console "HTML tag" verification: paste only the content="…" value. Build-time variable.
# Not needed if the property is verified by DNS.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Translate site text that is not wrapped in tr()/<T> by exact match against Admin → Translations (default on).
# Set to false to turn that browser-side pass off; wrapped text is translated either way.
# NEXT_PUBLIC_DOM_TRANSLATE=false
