generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ─────────────────────────────────────────────────────────────────────

enum Role {
  BUYER
  SELLER
  ADMIN
  AGENT
  ORGANIZATION
  COMPANY
}

enum Country {
  UAE
  UGANDA
  KENYA
  CHINA
}

enum Currency {
  AED
  UGX
  KES
  CNY
  USD
}

enum Condition {
  NEW
  USED
}

// Unit the listing's `price` is quoted per. Defaults to ITEM (the price is
// for the whole listing, e.g. a piece of equipment). Agriculture listings
// (crops, produce, livestock feed, etc.) commonly sell by weight instead,
// so KG/TONNE let a farmer quote e.g. "UGX 2,500 / kg" — see the "Price
// unit" selector on the Agriculture quick-post form (create-produce).
enum PriceUnit {
  ITEM
  KG
  TONNE
}

enum ListingStatus {
  ACTIVE
  PENDING
  SOLD
  EXPIRED
  HIDDEN
  REJECTED
}

enum Placement {
  NONE
  LATEST_COLLECTIONS
  FEATURED_DEAL
  FLASH_SALE
  BACK_TO_SCHOOL
}

enum ImageStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum KycDocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
  BUSINESS_LICENSE
}

enum NotificationType {
  LISTING_APPROVED
  LISTING_REJECTED
  IMAGE_APPROVED
  IMAGE_REJECTED
  REVIEW_POSTED
  MESSAGE_RECEIVED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_EXPIRED
  SUBSCRIPTION_PENDING
  LISTING_EXPIRED
  KYC_APPROVED
  KYC_REJECTED
  OFFER_RECEIVED
  OFFER_ACCEPTED
  OFFER_DECLINED
  OFFER_COUNTERED
  SYSTEM
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  COUNTERED
  WITHDRAWN
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING_PAYMENT
}

enum PackageScope {
  LISTING
  CV
  STORE   // Webstore plans: price, duration, listing cap and tier all come from the package
}

// ─── Listing visibility tiers (Free / Gold / Platinum) ─────────────────────
// Distinct from `Placement` above: Placement is admin-curated homepage
// sections (Flash Deals, Featured Deal, Latest Collections, Back to
// School) that a seller with an active rental can opt a listing into.
// ListingTier is the *base* visibility rung every listing sits on in the
// general feed/search/category views, independent of whether it's also in
// one of those curated sections. Render priority across the whole site is:
// FLASH_SALE placement > PLATINUM tier > GOLD tier > FREE tier — see
// backend/src/routes/listings.ts's tier sort (admin pins from Admin → Homepage
// Layout sort above all of it via Listing.pinOrder).
enum ListingTier {
  FREE
  GOLD
  PLATINUM
}

// ─── Models ────────────────────────────────────────────────────────────────────

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  personalId            String    @unique @default("")
  password              String
  role                  Role      @default(BUYER)
  name                  String
  phone                 String?   @unique
  avatar                String?
  country               Country   @default(UGANDA)
  isVerified            Boolean   @default(false)
  isBanned              Boolean   @default(false)
  // ─── KYC (Know Your Customer) identity verification ───────────────────────
  // Distinct from `isVerified` above (which reflects email confirmation /
  // active-paid-subscription status elsewhere in the app) — this tracks the
  // separate identity-document review flow. Sellers with kycStatus APPROVED
  // get priority in the admin listing-approval queue and a "KYC Verified"
  // badge on their public profile and listings.
  kycStatus             KycStatus @default(NOT_SUBMITTED)
  // Denormalized boolean mirror of `kycStatus === APPROVED`, kept in sync by
  // the admin KYC approve/reject endpoints. Exists so callers (badge display,
  // priority sort in the admin listing queue and public browse) can use a
  // simple boolean instead of comparing/ordering the enum, which is more
  // reliable across DB engines than relying on enum declaration order.
  isKycVerified         Boolean   @default(false)
  kycDocumentType       KycDocumentType?
  kycDocumentUrl        String?
  // Back-of-document upload — only required/used for document types that
  // have two sides (national ID, driver's licence). Passport and business
  // licence verification use a single page/document, so this stays null
  // for those types. See VALID_TWO_SIDED_DOCUMENT_TYPES in kyc.ts for the
  // authoritative list of which document types require it.
  kycDocumentBackUrl    String?
  kycSelfieUrl          String?
  kycFullName           String?
  kycSubmittedAt        DateTime?
  kycReviewedAt         DateTime?
  kycReviewedBy         String?
  kycRejectionReason    String?
  // Brief standard form collected with the documents when the verification is for a Webstore or
  // a Partner (kycPurpose = WEBSTORE | PARTNER); PERSONAL verifications leave these empty.
  kycPurpose            String?
  kycBusinessName       String?
  kycBusinessRegNumber  String?
  kycPhone              String?
  kycAddress            String?
  // ─── KYC in-progress draft (resumable verification workflow) ──────────────
  // Sensitive KYC documents must never be persisted client-side (browser
  // storage), but the verification form still needs to survive a refresh,
  // closed tab, dropped connection, or navigation away mid-flow. These
  // fields hold the *in-progress, not-yet-submitted* selections/uploads
  // server-side so the frontend can restore them on load. They're distinct
  // from the kyc*/kycDocument* fields above, which only ever hold the most
  // recently *submitted* verification — a draft never overwrites a real
  // submission, and is cleared once POST /kyc/submit succeeds.
  kycDraftDocumentType    KycDocumentType?
  kycDraftFullName        String?
  kycDraftDocumentUrl     String?
  kycDraftDocumentBackUrl String?
  kycDraftSelfieUrl       String?
  kycDraftUpdatedAt       DateTime?
  emailVerificationToken  String?   @unique
  emailVerificationExpiry DateTime?
  refreshToken          String?
  passwordResetToken    String?
  passwordResetExpiry   DateTime?
  cvThemeColor          String?
  // Extended profile fields for AGENT / ORGANIZATION / COMPANY accounts
  companyName           String?
  registrationNumber    String?   @unique
  agentLicense          String?   @unique
  agentType             String?
  website               String?
  businessDescription   String?
  socialLinks           Json?
  // Presence for the chat UI's online/offline indicator (green = active
  // within the last 2 minutes, grey = offline) — refreshed by a
  // lightweight, throttled touch in the `authenticate` middleware (see
  // middleware/auth.ts) rather than a dedicated "ping" endpoint, so it
  // stays accurate without the frontend needing to remember to call
  // anything. Nullable: null just reads as "never seen online" (offline).
  lastActiveAt          DateTime?
  // Preferred number of listing cards per row on /profile/listings (1-6). null = use the
  // site default. Enforced by a CHECK constraint in the migration and by the API.
  listingColumns        Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  listings         Listing[]
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  favorites        Favorite[]
  reports          Report[]
  givenReviews     Review[]  @relation("GivenReviews")
  receivedReviews  Review[]  @relation("ReceivedReviews")
  savedSearches    SavedSearch[]
  uploadedImages   ProductImage[] @relation("SellerImages")
  productReviews   ProductReview[] @relation("UserProductReviews")
  helpfulVotes     HelpfulVote[]   @relation("UserHelpfulVotes")
  notifications    Notification[]
  store            Store?
  subscriptions    SellerSubscription[]
  siteMedia        SiteMedia[]          @relation("AdminMediaUploads")
  documents        UserDocument[]
  blogPosts        BlogPost[]           @relation("BlogAuthor")
  storeRentals     StoreRental[]        @relation("StoreRentalUser")
  listingEngagements ListingEngagement[]
  cvDownloadTokens CvDownloadToken[]
  searchLogs       SearchLog[]
  listingClickLogs ListingClickLog[]
  offersAsBuyer    PriceOffer[] @relation("OfferBuyer")
  offersAsSeller   PriceOffer[] @relation("OfferSeller")
  pushSubscriptions PushSubscription[]
  notificationPreference NotificationPreference?

  @@index([kycStatus, kycSubmittedAt])
  @@index([isKycVerified])
}

model Store {
  id                String    @id @default(uuid())
  name              String
  description       String?
  logo              String?
  banner            String?
  slug              String    @unique
  rating            Float     @default(0)
  ratingCount       Int       @default(0)
  isActive          Boolean   @default(true)
  // Partner wall: admin approves stores as partners; approved stores can
  // upload a logo that appears on the public /stores Partners section.
  partnerApproved   Boolean   @default(false)
  partnerLogoUrl    String?
  partnerName       String?
  partnerWebsite    String?
  partnerApprovedAt DateTime?
  // Store Dashboard branding — background theme for the store's public
  // page and dashboard chrome. Only a Registered Store (not an ordinary
  // user) can set this, and only via the Store Dashboard (see
  // frontend/app/dashboard/store-rental/branding/page.tsx), never per-
  // listing. Shape: { presetId?: string, primaryColor?: string,
  // backgroundImage?: string | null } — null/unset renders the site's
  // default theme.
  backgroundTheme   Json?
  // Admin "pin" rank for the Trusted Sellers row and /stores (lower = first,
  // null = not pinned). Unpinned stores order by their rental tier.
  pinOrder          Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  icon        String?
  parentId    String?
  fieldSchema Json?
  parent      Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToSubcategory")
  listings    Listing[]
}

model Listing {
  id          String        @id @default(uuid())
  title       String
  description String
  price       Float
  // Optional "was" price. When greater than `price` the listing shows a
  // strike-through + discount badge and qualifies for Special Offers once the
  // discount reaches SiteConfig.specialOffers.minDiscountPercent.
  originalPrice Float?
  // What `price` is quoted per — see the PriceUnit enum doc comment.
  priceUnit   PriceUnit     @default(ITEM)
  currency    Currency      @default(UGX)
  condition   Condition     @default(USED)
  status      ListingStatus @default(ACTIVE)
  images      String[]
  location    String
  country     Country       @default(UGANDA)
  views       Int           @default(0)
  // Optional units available (bulk / produce); null = single item
  quantity    Int?
  tags        String[]
  motorDetails    Json?
  propertyDetails Json?
  jobDetails      Json?
  productOptions  Json?   // Array of options e.g. [{name:"Color",values:["Red","Blue"]}]
  // Answers to the selected category's admin-defined fieldSchema (see
  // Category.fieldSchema), keyed by field name, e.g. {"engine_capacity":"2.0L"}.
  customFieldValues Json?
  // ─── AI ad moderation (Module 1) — see backend/src/lib/llm.ts and the
  // moderation hook in POST /listings, PUT /listings/:id, and
  // POST /listings/bulk-produce. Null on every field means the listing was
  // never checked (LLM not configured, or created before this feature
  // existed) — not the same as a checked-and-approved listing, which has
  // True only while status is HIDDEN and a moderator/admin did the hiding: the owner may then not un-hide it.
  hiddenByModerator Boolean @default(false)
  // moderationFlaggedCategory: "none".
  moderationFlaggedCategory String?   // "spam" | "scam" | "prohibited_goods" | "none" — passed through from the LLM's own enum, not re-validated against a Prisma enum, since an unrecognized value here should surface for a human to see rather than silently coerce to "none"
  moderationConfidence      Float?    // 0.0–1.0, the LLM's confidence in flagged_category
  moderationReason          String?   // the LLM's own "developer_reason" — shown to admins reviewing the listing, never to the seller
  moderationCheckedAt       DateTime?
  latitude        Float?
  longitude       Float?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  expiresAt   DateTime?
  placement          Placement     @default(NONE)
  placementExpiresAt DateTime?
  // ─── Visibility tier (Free/Gold/Platinum) ────────────────────────────────
  // Ordinary users: set from the tier they select on the pricing selector
  // shown immediately before "Post Listing" (see POST /listings), confirmed
  // and given its tierExpiresAt window by an admin at approval time (same
  // moment placement+placementExpiresAt above get set) — never trusted from
  // the client alone, since Gold/Platinum are paid tiers.
  // Store-owned listings: mirrors the owning Store's current StoreRental.tier
  // rather than being set per-listing — kept in sync by
  // syncStoreListingsTier() (routes/storeRentals.ts) whenever the store's
  // tier changes or its rental expires, and tierExpiresAt is left null for
  // these (the store's own rental.endDate is the source of truth for when
  // the tier lapses, not a per-listing timer).
  tier               ListingTier @default(FREE)
  tierExpiresAt      DateTime?
  // What an ordinary user selected on the pre-post pricing selector, before
  // an admin has reviewed/confirmed payment for it — null once resolved
  // (admin approval either sets `tier` to match this and clears it, or
  // rejects it back to FREE and clears it). Not read by anything that
  // renders the listing; it's purely the admin review queue's signal for
  // "this one asked for Gold/Platinum, check payment before approving."
  // Always null for store-owned listings (they don't go through this
  // per-listing request flow at all — see the `tier` field comment above).
  requestedTier      ListingTier?
  // Admin "pin" rank for homepage rows / the main feed (Admin → Homepage
  // Layout). Lower number = shown first; null = not pinned (ordinary tier
  // ordering applies). Pinned listings sort above everything else in
  // whichever row they already qualify for.
  pinOrder           Int?
  // Whether buyers may send price offers on this listing (see PriceOffer). Sellers can switch it off.
  acceptsOffers      Boolean       @default(true)

  userId      String
  user        User          @relation(fields: [userId], references: [id])
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])

  messages    Message[]
  favorites   Favorite[]
  reports     Report[]
  reviews     Review[]
  productImages ProductImage[]
  productReviews ProductReview[]
  engagement  ListingEngagement[]
  clickLogs   ListingClickLog[]
  priceOffers PriceOffer[]

  @@index([country, status, createdAt(sort: Desc)])
  @@index([status, categoryId])
  @@index([categoryId, country, status])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([status, placement, country])
  @@index([country, placement, status])
  @@index([createdAt(sort: Desc)])
  @@index([status, tier, updatedAt])
  @@index([pinOrder])
}

model ListingEngagement {
  id              String   @id @default(uuid())
  durationSeconds  Int      @default(0)
  createdAt        DateTime @default(now())

  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  listingId       String
  listing         Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([listingId, createdAt])
}

// ─── Search & click analytics ──────────────────────────────────────────────
// Records every genuine search (a typed term and/or an applied filter — bare
// unfiltered browsing is not logged) made through GET /listings, and every
// listing detail view ("item click") made through GET /listings/:id.
// `context`/snapshot fields are the always-recorded facts about what was
// searched / clicked; the userId/userEmail/userPhone/location fields are
// filled in only when available (signed-in user and/or the browser granted
// geolocation) — see utils/analyticsLogger.ts, which writes both models.

model SearchLog {
  id                String   @id @default(uuid())
  // Free-text search term (the `q` param), if any — a filter-only search
  // (e.g. category + price range with no typed term) leaves this null.
  query             String?
  // JSON snapshot of the full search context (q, category, location,
  // country, priceMin, priceMax, condition, brand, verifiedOnly, sort,
  // page) — the mandatory record of what was searched, kept as JSON so new
  // filters can be added later without a schema migration.
  context           String
  resultCount       Int?

  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Snapshots taken at search time (not a live join) so the log stays
  // accurate even if the user later changes their email/phone.
  userEmail         String?
  userPhone         String?

  ip                String?
  // Country code detected from the CDN/edge header (e.g. Cloudflare's
  // cf-ipcountry) — always-available, coarse location signal.
  ipCountry         String?
  // Best-effort, high-accuracy location from the browser's Geolocation API,
  // only present when the visitor's browser granted permission.
  latitude          Float?
  longitude         Float?
  locationAccuracy  Float?   // meters
  userAgent         String?

  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([query])
  @@index([userId, createdAt])
}

model ListingClickLog {
  id                String   @id @default(uuid())
  listingId         String?
  listing           Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  // Snapshots of the clicked item's title/image at click time — kept even
  // if the listing is later edited or deleted, so the "most clicked items"
  // report always has a title and image preview to show.
  listingTitle      String
  listingImage      String?

  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail         String?
  userPhone         String?

  ip                String?
  ipCountry         String?
  latitude          Float?
  longitude         Float?
  locationAccuracy  Float?   // meters
  userAgent         String?

  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([listingId, createdAt])
  @@index([userId, createdAt])
}


model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Notification bell/inbox always queries "this user's notifications,
  // newest first" (and often filters unread-only) — covers both.
  @@index([userId, read, createdAt(sort: Desc)])
  // The push/WhatsApp dispatcher scans only the most recent notifications.
  @@index([createdAt])
}

model Message {
  id         String   @id @default(uuid())
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  listingId  String?
  listing    Listing? @relation(fields: [listingId], references: [id])
  // Set when this chat message carries a price offer (shown as an offer card in the thread).
  offerId    String?
  offer      PriceOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  // The inbox/conversation queries (see routes/messages.ts) always filter
  // by one side of the conversation ordered by recency, or by the unread
  // count for a given receiver.
  @@index([senderId, createdAt(sort: Desc)])
  @@index([receiverId, createdAt(sort: Desc)])
  @@index([receiverId, read])
  @@index([offerId])
}

// ─── Price offers / negotiation ───────────────────────────────────────────────
// One row per step of a negotiation between a buyer and the listing's seller. A buyer's first offer
// is a row made by the buyer; a counter-offer is a new row (parentId = the offer it answers) and the
// answered row becomes COUNTERED. The latest row of a (listing, buyer) pair is the live state.
model PriceOffer {
  id          String      @id @default(uuid())
  listingId   String
  listing     Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       User        @relation("OfferBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      User        @relation("OfferSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  // Which of the two parties made this step (always buyerId or sellerId); the other party answers it.
  madeById    String
  amount      Float
  currency    Currency
  status      OfferStatus @default(PENDING)
  note        String?
  parentId    String?
  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  messages    Message[]

  @@index([listingId, buyerId, createdAt(sort: Desc)])
  @@index([buyerId, status])
  @@index([sellerId, status])
}

// ─── Push / WhatsApp notification delivery ────────────────────────────────────
// A browser (Web Push) subscription. One user can have several (phone, laptop, ...).
model PushSubscription {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?

  @@index([userId])
}

// Per-user alert settings. Created lazily the first time the user changes one.
model NotificationPreference {
  userId                String    @id
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Chat messages can be noisy; turning this off silences push/WhatsApp for messages only.
  notifyMessages        Boolean   @default(true)
  // WhatsApp alerts are sent only to a number the user has proved they own (verification code).
  whatsappNumber        String?
  whatsappVerifiedAt    DateTime?
  whatsappCodeHash      String?
  whatsappCodeExpiresAt DateTime?
  whatsappCodeAttempts  Int       @default(0)
  updatedAt             DateTime  @updatedAt
}

// Claim/audit row for every external delivery attempt. The (notificationId, channel) uniqueness is
// what guarantees one push / one WhatsApp per notification even with several app instances, and
// the (userId, channel, createdAt) index backs the WhatsApp throttles.
model NotificationDelivery {
  id             String   @id @default(uuid())
  notificationId String?
  userId         String
  channel        String
  type           String?
  status         String
  detail         String?
  createdAt      DateTime @default(now())

  @@unique([notificationId, channel])
  @@index([userId, channel, createdAt])
  @@index([createdAt])
}

model Favorite {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])

  @@unique([userId, listingId])
  @@index([listingId])
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id         String   @id @default(uuid())
  reason     String
  createdAt  DateTime @default(now())
  // Moderation outcome (Admin → Reports)
  status       ReportStatus @default(OPEN)
  resolution   String?      // REMOVE_LISTING | WARN_SELLER | BAN_SELLER | NO_ACTION | DISMISSED
  adminNote    String?
  resolvedAt   DateTime?
  resolvedById String?

  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id])
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id])
}

model Review {
  id         String   @id @default(uuid())
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  reviewerId  String
  reviewer    User    @relation("GivenReviews", fields: [reviewerId], references: [id])
  revieweeId  String
  reviewee    User    @relation("ReceivedReviews", fields: [revieweeId], references: [id])
  listingId   String
  listing     Listing @relation(fields: [listingId], references: [id])
}

/// A buyer's saved listing search. `filters` holds the /listings query keys (whitelisted in
/// utils/savedSearches.ts); with `emailAlert` on, the lifecycle sweep notifies the owner about new
/// matching listings created after `lastCheckedAt`. (`query` is legacy and unused.)
model SavedSearch {
  id            String   @id @default(uuid())
  query         String?
  name          String   @default("")
  filters       Json?
  emailAlert    Boolean  @default(false)
  lastCheckedAt DateTime @default(now())
  createdAt     DateTime @default(now())

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([emailAlert, lastCheckedAt])
}

model ProductImage {
  id              String      @id @default(uuid())
  listingId       String?
  listing         Listing?    @relation(fields: [listingId], references: [id], onDelete: SetNull)
  sellerId        String
  seller          User        @relation("SellerImages", fields: [sellerId], references: [id])
  tempPath        String
  status          ImageStatus @default(PENDING)
  cdnUrl          String?
  uploadedAt      DateTime    @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?
}

model ProductReview {
  id               String        @id @default(uuid())
  listingId        String
  listing          Listing       @relation(fields: [listingId], references: [id])
  userId           String
  user             User          @relation("UserProductReviews", fields: [userId], references: [id])
  rating           Int
  title            String?
  content          String
  status           ReviewStatus  @default(PENDING)
  helpfulCount     Int           @default(0)
  rejectionReason  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  helpfulVotes     HelpfulVote[]

  @@unique([userId, listingId])
  @@index([listingId, status])
}

model HelpfulVote {
  id        String        @id @default(uuid())
  reviewId  String
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation("UserHelpfulVotes", fields: [userId], references: [id])
  createdAt DateTime      @default(now())

  @@unique([reviewId, userId])
}

// ─── Seller Packages & Subscriptions ──────────────────────────────────────────

model SellerPackage {
  id            String               @id @default(uuid())
  name          String
  description   String?
  scope         PackageScope         @default(LISTING)
  isFree        Boolean              @default(false)
  price         Float                @default(0)
  currency      Currency             @default(UGX)
  durationDays  Int
  maxListings   Int?
  isActive      Boolean              @default(true)
  // STORE scope only: the visibility tier (FREE/GOLD/PLATINUM) a webstore on this package gets.
  storeTier     ListingTier?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  subscriptions SellerSubscription[]
  cvDownloadTokens CvDownloadToken[]
}

model SellerSubscription {
  id         String             @id @default(uuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId  String
  package    SellerPackage      @relation(fields: [packageId], references: [id])
  status     SubscriptionStatus @default(ACTIVE)
  startDate  DateTime           @default(now())
  endDate    DateTime
  paymentRef String?
  // Lifecycle bookkeeping (see utils/subscriptionService.ts): when the "expiring soon"
  // reminder went out (so the sweep never sends a second one for the same period), and
  // when the owner/admin cancelled it.
  reminderSentAt DateTime?
  cancelledAt    DateTime?

  // ── Package snapshot ────────────────────────────────────────────────────────
  // The package terms exactly as they were when this term was requested. Every read
  // (entitlement, admin approval, revenue) uses these rather than the live package row, so an
  // admin editing a package never silently rewrites what an existing subscriber agreed to.
  // `snapshotAt` is the marker: null = a legacy/internal row that still follows its package.
  // (maxListings null + snapshotAt set = "unlimited", which is why the marker is needed.)
  snapshotAt     DateTime?
  packageName    String?
  pricePaid      Float?
  currency       Currency?
  durationDays   Int?
  maxListings    Int?

  // ── How this term came about ────────────────────────────────────────────────
  // changeKind: NEW | RENEWAL | UPGRADE.  upgradeMode (UPGRADE only): AFTER_EXPIRY starts the
  // new term when the current one ends; IMMEDIATE cancels the current term when an admin
  // confirms payment and starts the new one right away. replacesId = the term being
  // renewed/upgraded.
  changeKind     String             @default("NEW")
  upgradeMode    String?
  replacesId     String?

  // Admin decision trail (set when a PENDING_PAYMENT request is approved).
  approvedAt     DateTime?
  approvedById   String?
  adminNote      String?

  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([userId, status, endDate])
  @@index([status, endDate])
}

// ─── Site Statistics ───────────────────────────────────────────────────────────
// Single-row table used as a global counters store.  A row with id="global"
// is upserted whenever the homepage is visited.


model SiteStat {
  id                 String    @id @default("global")
  pageViews          BigInt    @default(0)
  dailyVisitors      BigInt    @default(0)
  lastDailyReset     DateTime  @default(now())
  lastResetDayKey    String    @default("") // YYYY-MM-DD day key (computed in the relevant country's local timezone) of the last daily reset — timezone-aware replacement for comparing lastDailyReset with server-local dates
  visitorCountries   String    @default("[]") // JSON array of unique country codes
  countryVisitCounts String    @default("{}") // JSON map of country code → visit count e.g. {"US": 42, "AE": 15}
  uniqueVisitorIds   String    @default("[]") // JSON array of unique device IDs (all time)
  dailyVisitorIds    String    @default("[]") // JSON array of device IDs for today
  updatedAt          DateTime  @updatedAt
}

// Per-device, per-day visit log — the admin-facing "proof" record behind the
// aggregate counters in SiteStat above. One row per deviceId per local day
// (dayKey), upserted on every POST /stats/track call: durationSeconds is the
// span between firstSeenAt and lastSeenAt that day (a best-effort "time on
// site" proxy — it only grows when the device actually pings the endpoint
// again, e.g. by loading another page — not a continuous idle-tab timer).
model VisitorLog {
  id              String   @id @default(uuid())
  deviceId        String
  dayKey          String   // YYYY-MM-DD, local to the visitor's detected/selected country
  ip              String
  country         String?
  userAgent       String?
  device          String?  // friendly label parsed from the user agent, e.g. "Mobile · Safari"
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  durationSeconds Int      @default(0)
  visitCount      Int      @default(1)

  @@unique([deviceId, dayKey])
  @@index([lastSeenAt])
  @@index([ip])
  @@index([dayKey])
}

// ─── Site Media (admin-uploaded images for page sections) ─────────────────────

model SiteMedia {
  id          String   @id @default(uuid())
  section     String   // e.g. 'hero', 'banner', 'featured', 'flash', 'collection'
  cdnUrl      String
  title       String?
  shortDescription String?
  price       Decimal?
  originalPrice Decimal?
  currency    Currency?
  altText     String?
  linkUrl     String?  // Optional destination URL when the image is clicked
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  uploadedBy  String
  admin       User     @relation("AdminMediaUploads", fields: [uploadedBy], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

