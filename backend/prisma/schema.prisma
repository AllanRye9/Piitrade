// ─── Site Config (WhatsApp number, Today's Deals, theme) ─────────────────────

model SiteConfig {
  id              String   @id @default("global")
  whatsappNumber  String?
  todaysDeals     Json?    // Array of deal objects { id, title, description, imageUrl, price, originalPrice, discount, link }
  headerTheme     String?  // ThemeKey string e.g. "sky", "violet" etc.
  logoUrl         String?  // CDN URL of the uploaded site logo
  logoPages       Json?    // Array of page keys where logo should appear e.g. ["homepage","exchange","dashboard"]
  logoAltText     String?  // Alt text for the logo image
  logoSize        Int?     // Admin-adjustable display height in px (default 28) for the exchange widget logo
  logoLinkUrl     String?  // URL the logo/image navigates to when clicked
  logoDisplayMode String?  // "inline" (logo next to "PIITRADE EXCHANGE · Money Transfer Rates" text) or "replace" (image replaces the text entirely). Defaults to "inline".
  interviewDemoVideoUrl   String? // CDN URL of the admin-uploaded interview demo video
  interviewDemoVideoTitle String? // Optional caption shown above the video on the interview page
  promoVideoUrl           String? // CDN URL of the admin-uploaded "Live Now / Shop Now" promo video shown beside the homepage hero slideshow. Shows a branded placeholder when unset.
  promoVideoTitle         String? // Optional internal label for the promo video (not shown on the site)
  enabledCountries String[] @default(["UGANDA"]) // Countries publicly selectable on the storefront (country switcher, welcome modal, /country/* pages). Admin-configurable from /admin/settings so UAE/Kenya/China can be turned on later without a code change.
  generalSettings Json?    // { siteName, maintenanceMode, allowRegistration, defaultCountry, itemsPerPage, maxImagesPerListing, trialDays }
  blogPopup       Json?    // Admin-configurable homepage blog popup: { enabled: boolean, intervalSeconds: number, postId: string | null }. `postId` pins a specific BlogPost; when null (or the pinned post is no longer PUBLISHED) the most recently published post is shown instead. See GET /api/blog/popup for the resolved shape served to the public site.
  backToSchool    Json?    // Admin-controlled "Back to School" homepage section: { enabled: boolean, startAt: string | null, endAt: string | null }. Which listings appear is controlled separately via Listing.placement = 'BACK_TO_SCHOOL'. See GET /api/site-config/back-to-school.
  specialOffers   Json?    // Admin-controlled "Special Offers" (formerly "Special Finds"): { enabled: boolean, minDiscountPercent: number, startAt: string | null, endAt: string | null }. Falls back to generalSettings.specialFindsEnabled for `enabled` on first read after migration. See GET /api/site-config/special-offers.
  // AI Customer Support chat (Module 2) — the "Platform Policy Context" the
  // LLM is restricted to answering from (see backend/src/routes/support.ts
  // and backend/src/lib/llm.ts). Plain text, not JSON, so an admin can just
  // paste in their FAQ/policies as-is; null/empty means the chat always
  // falls back to the human-transfer message (nothing to ground answers in).
  supportFaqContext String?
  // Admin-set catalog prices for Free/Gold/Platinum — the one config
  // surface for "Admin configures all prices from the Admin Panel"
  // covering both purchase paths: an ordinary user's per-listing tier
  // selector (shown just before "Post Listing") and a store's subscription
  // tier (managed in the Store Dashboard, applied via StoreRental.tier).
  // Shape: { currency: Currency, listingGoldPrice: number,
  // listingPlatinumPrice: number, listingTierDurationDays: number,
  // storeFreeFee: number, storeGoldFee: number, storePlatinumFee: number }.
  // See GET/PUT /admin/site-config/tier-pricing.
  tierPricing       Json?
  updatedAt       DateTime @updatedAt
}

// ─── CV Download Token (server-side payment verification) ─────────────────────
// Created after successful payment; the frontend must present the token to
// trigger the signed download URL. Tokens expire after 24 hours.

model CvDownloadToken {
  id          String   @id @default(uuid())
  userId      String?  // null for guest payments
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  deviceId    String?  // client-generated id, used to rate-limit guest downloads
  packageId   String?  // the CV package that governed this download, if any
  package     SellerPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  tokenHash   String   @unique
  paid        Boolean  @default(false)
  amount      Decimal
  currency    String
  country     String
  expiresAt   DateTime
  usedAt      DateTime?
  // How many times /validate has released this paid token for a download (capped, see cvPayment.ts).
  downloadCount Int    @default(0)
  createdAt   DateTime @default(now())

  // CV history snapshot — captured when the download is initiated so the
  // admin dashboard can show a history of created CVs without needing to
  // store (or re-derive) the full builder form state.
  holderName  String?
  holderTitle String?
  holderEmail String?
  holderPhone String?

  @@index([packageId, userId])
  @@index([packageId, deviceId])
}

// ─── AI Customer Support → human handoff ────────────────────────────────────
// Created when the support bot cannot answer and the shopper asks for a
// human (POST /support/handoff). Admins are notified and work the queue at
// /admin/support-requests. userId is a plain string (no FK) so guests and
// deleted accounts never block or cascade-delete a request.
enum SupportRequestStatus {
  OPEN
  RESOLVED
}

model SupportRequest {
  id            String               @id @default(uuid())
  userId        String?
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  question      String
  transcript    Json?
  status        SupportRequestStatus @default(OPEN)
  adminResponse String?
  resolvedBy    String?
  resolvedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([userId])
}

// One saved support-chat conversation per logged-in user, so it follows them
// across devices. userId is a plain string (no FK), like SupportRequest.
model SupportChatHistory {
  userId      String   @id
  messages    Json
  handoffDone Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

// ─── Job applications ───────────────────────────────────────────────────────
// A CV is shared with a recruiter ONLY through an application: the applicant
// attaches one of their own CV documents when applying, and only that job's
// poster (or an admin) may open it. CVs are never listed or browsable on the
// public /jobs board. applicantId / documentId are plain strings (no FK) so a
// deleted account or document never cascades away the recruiter's record.
enum JobApplicationStatus {
  SUBMITTED
  SHORTLISTED
  REJECTED
}

model JobApplication {
  id          String               @id @default(uuid())
  jobId       String
  job         JobPost              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId String
  documentId  String
  cvTitle     String
  coverNote   String?
  phone       String?
  status      JobApplicationStatus @default(SUBMITTED)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([jobId, applicantId])
  @@index([jobId, createdAt(sort: Desc)])
  @@index([applicantId, createdAt(sort: Desc)])
}

// ─── Mobile-money payments (MTN MoMo — collection only) ───────────────────────
// One row per payment ATTEMPT. The platform is the sole beneficiary of every
// payment (subscriptions, store rentals/renewals, listing tiers, CV downloads),
// so this is a plain collection ledger: no escrow, no splits, no payouts.
// It is deliberately decoupled from the records it unlocks: `targetId` is a
// polymorphic plain string (meaning depends on `purpose`) and `userId` is a plain
// string with NO foreign key, so deleting an account or a target never deletes the
// financial record (same approach as JobApplication / SupportRequest).
//   referenceId  = the MTN X-Reference-Id (UUID v4) — unique per attempt, idempotency key.
//   amount/currency       = what we charge (always the real UGX price, derived server-side).
//   providerAmount/Currency = what was sent to MTN (the sandbox only accepts EUR).
//   status       = payment outcome as MTN reports it; provisionedAt = when access was granted
//                  (separate on purpose: a crash between the two is retried by the reconciler).
// A partial unique index (see migration 20261020120000_momo_payments) allows at most one
// PENDING attempt per (purpose, targetId).
enum PaymentPurpose {
  SUBSCRIPTION
  SUBSCRIPTION_RENEWAL
  SUBSCRIPTION_UPGRADE
  STORE_RENTAL
  STORE_RENEWAL
  LISTING_TIER
  CV_DOWNLOAD
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  EXPIRED
  NEEDS_REVIEW
  // Money returned to the payer outside the system (set by an admin resolving a NEEDS_REVIEW payment).
  REFUNDED
}

model PaymentTransaction {
  id                     String         @id @default(uuid())
  referenceId            String         @unique
  provider               String         @default("MTN_MOMO")
  environment            String
  purpose                PaymentPurpose
  targetId               String
  userId                 String?
  amount                 Decimal        @db.Decimal(18, 2)
  currency               Currency       @default(UGX)
  providerAmount         Decimal        @db.Decimal(18, 2)
  providerCurrency       String
  msisdn                 String
  status                 PaymentStatus  @default(PENDING)
  providerStatus         String?
  failureReason          String?
  financialTransactionId String?
  provisionedAt          DateTime?
  // Lease taken while access is being granted, so two workers never provision the same payment;
  // it expires on its own (see PROVISION_LEASE_MS) if a worker dies mid-way.
  provisioningStartedAt  DateTime?
  provisionNote          String?
  // Digital receipt, issued once the payment is SUCCESSFUL and access has been granted. The
  // tracking code is unique per receipt and is what a payer / support quotes to find it. The PDF is
  // rebuilt from this row on demand (never stored), so it can never drift from the ledger.
  receiptNumber          String?        @unique
  receiptIssuedAt        DateTime?
  receiptEmailedAt       DateTime?
  receiptEmailAttempts   Int            @default(0)
  lastCheckedAt          DateTime?
  checkCount             Int            @default(0)
  metadata               Json?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([status, lastCheckedAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([purpose, targetId])
}

/// Append-only audit trail for sensitive admin actions (role changes, admin approvals).
/// No relations on purpose, so deleting a user never removes the record.
model AdminAuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  actorEmail  String?
  action      String
  targetId    String?
  targetEmail String?
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
  @@index([targetId])
}
