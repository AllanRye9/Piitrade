// ─── Store Rentals ────────────────────────────────────────────────────────────

enum RentalStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum RentalEntityType {
  USER
  AGENT
  COMPANY
  ORGANIZATION
}

model StoreRental {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation("StoreRentalUser", fields: [userId], references: [id], onDelete: Cascade)
  entityType      RentalEntityType @default(USER)
  // Subscription tier — drives which of the 3 seller-assignable placement
  // zones (LATEST_COLLECTIONS/FEATURED_DEAL/FLASH_SALE) the store can use
  // and what tier its listings render at (see syncStoreListingsTier() in
  // routes/storeRentals.ts, which cascades this onto every listing the
  // store owns whenever it changes). Defaults to FREE — a store rental can
  // exist and grant dashboard access without necessarily paying for Gold or
  // Platinum. Priced from SiteConfig.tierPricing (admin-set), see
  // GET/PUT /admin/site-config/tier-pricing.
  tier            ListingTier      @default(FREE)
  fee             Float            @default(0)
  currency        Currency         @default(UGX)
  startDate       DateTime         @default(now())
  endDate         DateTime
  maxListings     Int              @default(100)
  status          RentalStatus     @default(PENDING)
  // The admin package this rental was bought under (STORE scope). The terms actually applied
  // (fee, currency, tier, maxListings, endDate) are copied onto the rental at application time, so
  // later package edits never change a running store. durationDays/packageName are that snapshot.
  packageId       String?
  packageName     String?
  durationDays    Int?
  placements      Json?
  // Set the moment a renewal-reminder email goes out (see
  // sendStoreRenewalReminders() in routes/storeRentals.ts), so the
  // scheduled job never sends a second reminder for the same
  // upcoming expiry — it's cleared back to null on renewal (a new
  // endDate), so the *next* expiry gets its own fresh reminder.
  renewalReminderSentAt DateTime?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId, status])
  @@index([status, endDate])
}

