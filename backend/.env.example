# PostgreSQL connection URL.
# • Local development: use the standard postgresql:// scheme.
# • Railway: set this to the PUBLIC URL shown in the PostgreSQL service
#   variables panel (used by Prisma migrations and as a fallback).
#   Both postgresql:// and postgres:// schemes are accepted.
DATABASE_URL="postgresql://marketplace:marketplace_secret@localhost:55432/marketplace_db?schema=public"

# Railway internal private-network URL (optional but recommended on Railway).
# When present the backend uses this instead of DATABASE_URL for all runtime
# queries – it is faster and avoids public-proxy egress costs.
# Example: postgresql://postgres:<password>@<service>.railway.internal:55432/railway
# DATABASE_PRIVATE_URL="postgresql://postgres:<password>@<service>.railway.internal:55432/railway"

# Public URL of the deployed frontend. Used to build links inside
# transactional emails (verification, password reset, notifications, etc.).
# Falls back to https://piitrade.com if unset.
FRONTEND_URL="http://localhost:3000"

# Set to "false" to skip Prisma migrations on container start (e.g. when
# migrations are applied out-of-band in CI/CD). Anything other than the
# literal string "false" is treated as enabled — this is the default.
AUTO_MIGRATE_ON_START=true

JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=5000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"
# Public base URL of this backend API.  Used to construct image proxy URLs
# when serving uploaded files through /api/images.
# Example: https://api.yourdomain.com or https://backend.up.railway.app
API_BASE_URL=http://localhost:5000
# S3-compatible cloud storage (optional; Railway bucket is the preferred provider)
# When set, images are uploaded to the bucket and served through /api/images.
ACCESS_KEY_ID="your-access-key"
SECRET_ACCESS_KEY="your-secret-key"
BUCKET="your-bucket-name"
# Optional: custom S3-compatible endpoint (Railway bucket, MinIO, etc.)
# Leave empty for standard AWS S3.  Example values:
#   Railway:  https://<bucket-region>.railway-bucket.com
#   MinIO:    http://localhost:9000
ENDPOINT=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
ADMIN_PASSWORD="change-this-to-a-strong-password"
ADMIN_SECRET="change-this-to-a-strong-admin-registration-secret"

# Resend transactional email (optional; preferred over SMTP when configured)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMTP fallback email transport (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# AI features (ad moderation, cataloging/tag suggestions, support chat) —
# see backend/src/lib/llm.ts for full provider-resolution details. All
# three features are safe no-ops (fail open / fall back gracefully) when
# none of the below is set.
#
# Option A: point at Hugging Face's OpenAI-compatible router (Llama 3.2 etc.)
HF_API_TOKEN=
# Option B: point at OpenAI directly
OPENAI_API_KEY=
# If both are set, Hugging Face is used by default — set LLM_PROVIDER=openai
# to prefer OpenAI instead.
LLM_PROVIDER=
# Optional override of the model name for whichever provider above is
# active (defaults: meta-llama/Llama-3.2-3B-Instruct for HF, gpt-4o-mini
# for OpenAI).
LLM_MODEL=
# Option C: a fully custom OpenAI-compatible endpoint (self-hosted
# vLLM/Ollama/etc.) — set both of these to bypass HF/OpenAI entirely.
LLM_API_URL=
LLM_API_KEY=
# Confidence (0.0-1.0) above which a flagged listing is auto-rejected
# outright instead of just being flagged for admin review. Default: 0.9
MODERATION_AUTO_REJECT_THRESHOLD=0.9

# --- Security switches (see SECURITY_AUDIT.md) ---
# Production refuses to start if JWT_SECRET / JWT_REFRESH_SECRET are < 32 chars,
# identical, or still contain placeholder text. Generate with: openssl rand -hex 48
# ALLOW_INSECURE_DEFAULTS=false        # only ever true for throwaway local smoke tests
# POST /api/auth/admin-register is DISABLED in production unless this is "true".
# Turn it on only long enough to create the first admin, then remove it.
# ENABLE_ADMIN_REGISTER=false
# Shared secret a payment gateway must send (header x-webhook-secret) to /api/cv-payment/confirm.
# CV_PAYMENT_WEBHOOK_SECRET=
# --- MTN Mobile Money (MoMo) — collection only ---------------------------------------------
# OFF by default. While MTN_ENABLED is not "true" nothing changes: payments are confirmed by an
# admin from the payment reference, exactly as before. The platform is the only beneficiary of
# every payment (subscriptions, store rentals, listing tiers, CV downloads): no escrow/splits/payouts.
# SANDBOX: create the API user + key once with `npm run momo:sandbox:provision` (needs only the
#   subscription key). PRODUCTION: MTN issues the API user/key — never reuse sandbox values.
# SANDBOX QUICK START (keys go in this file; quotes are fine):
#   1. MTN_SUBSCRIPTION_KEY="<primary key of your Collections product>"  (from momodeveloper.mtn.com)
#   2. npm run momo:sandbox:provision   -> prints a NEW MTN_API_USER and MTN_API_KEY for that key
#   3. put them below, set MTN_ENABLED=true, then verify: npm run momo:sandbox:check
#   MTN_API_USER / MTN_API_KEY must be generated for YOUR subscription key; example/placeholder values never work.
# MTN_ENABLED=false
# MTN_ENVIRONMENT=sandbox                   # sandbox | production
# MTN_TARGET_ENVIRONMENT=sandbox            # sandbox | MTN's country value in production (e.g. mtnuganda)
# MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com   # production defaults to https://proxy.momoapi.mtn.com — confirm with your MTN onboarding pack
# MTN_SUBSCRIPTION_KEY=                     # primary key of the *Collections* product
# MTN_API_USER=                             # UUID v4 registered with MTN
# MTN_API_KEY=                              # secret — never commit or log
# MTN_CURRENCY=EUR                          # the sandbox only accepts EUR; production must be UGX (the default)
# Where MTN calls back: this BACKEND's public https origin (NOT the frontend's). A bare origin is enough —
# /api/payments/momo/callback is appended. Defaults to API_BASE_URL. Leave both unset for polling-only.
# In the sandbox the host must match the providerCallbackHost registered for the API user.
# MTN_CALLBACK_URL=https://api.example.com
# Signs each payment's callback URL (>= 32 chars). Required when callbacks are on: openssl rand -hex 32
# MTN_CALLBACK_SECRET=                      # optional: derived from JWT_SECRET when unset
# With MTN_ENABLED=true, /api/cv-payment/confirm no longer lets a browser mark a download as paid.
