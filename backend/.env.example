# PostgreSQL connection URL.
# • Local development: use the standard postgresql:// scheme.
# • Railway: set this to the PUBLIC URL shown in the PostgreSQL service
#   variables panel (used by Prisma migrations and as a fallback).
#   Both postgresql:// and postgres:// schemes are accepted.
DATABASE_URL="postgresql://marketplace:marketplace_secret@localhost:5432/marketplace_db?schema=public"

# Railway internal private-network URL (optional but recommended on Railway).
# When present the backend uses this instead of DATABASE_URL for all runtime
# queries – it is faster and avoids public-proxy egress costs.
# Example: postgresql://postgres:<password>@<service>.railway.internal:5432/railway
DATABASE_PRIVATE_URL=

JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=5000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"
# Public base URL of this backend API.  Used to construct image proxy URLs
# when serving uploaded files through /api/images.
# Example: https://api.yourdomain.com or https://backend.up.railway.app
API_BASE_URL=http://localhost:5000
# S3-compatible cloud storage (optional; Railway bucket is the preferred provider)
# When set, images are uploaded to the bucket and served through /api/images.
ACCESS_KEY_ID="your-access-key"
SECRET_ACCESS_KEY="your-secret-key"
BUCKET="your-bucket-name"
# Optional: custom S3-compatible endpoint (Railway bucket, MinIO, etc.)
# Leave empty for standard AWS S3.  Example values:
#   Railway:  https://<bucket-region>.railway-bucket.com
#   MinIO:    http://localhost:9000
ENDPOINT=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
ADMIN_PASSWORD="change-this-to-a-strong-password"
ADMIN_SECRET="change-this-to-a-strong-admin-registration-secret"

# Resend transactional email (optional; preferred over SMTP when configured)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMTP fallback email transport (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
