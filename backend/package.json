{
  "name": "marketplace-backend",
  "version": "1.0.0",
  "description": "Piitrade Marketplace Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "db:setup": "ts-node --transpile-only scripts/db-setup.ts",
    "db:setup:hotfixes": "ts-node --transpile-only scripts/db-setup.ts --hotfixes-only",
    "momo:sandbox:provision": "ts-node --transpile-only scripts/momo-sandbox-provision.ts",
    "momo:sandbox:check": "ts-node --transpile-only scripts/momo-sandbox-check.ts",
    "migrations": "prisma migrate dev",
    "db:local:check": "bash scripts/prisma-local.sh check",
    "db:local:migrate": "bash scripts/prisma-local.sh migrate",
    "db:local:deploy": "bash scripts/prisma-local.sh deploy",
    "db:local:reset": "bash scripts/prisma-local.sh reset",
    "prisma:seed": "ts-node prisma/seed.ts",
    "seed:brand-fields": "ts-node --transpile-only scripts/seed-brand-fields.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "momo:live:check": "ts-node --transpile-only scripts/momo-live-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1014.0",
    "@aws-sdk/s3-request-presigner": "^3.1014.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@swc/helpers": "^0.5.19",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.15.2",
    "pg": "^8.23.0",
    "resend": "^4.1.2",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "uuid": "^14.0.1",
    "web-push": "^3.6.7",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.7",
    "@types/sanitize-html": "^2.16.2",
    "@types/uuid": "^11.0.0",
    "@types/web-push": "^3.6.4",
    "prisma": "^7.10.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^5.0.5"
  }
}
